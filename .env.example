# Copy to .env and fill from deployment outputs. Never commit the populated file.
# All Azure access uses DefaultAzureCredential; no keys are required.

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-supply-disruption
AZURE_LOCATION=swedencentral

# Microsoft Foundry
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
MODEL_DEPLOYMENT_NAME=gpt-4o
MODEL_MAX_CONCURRENCY=6
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_DATABASE=SupplyChainDB

# Azure AI Search
SEARCH_ENDPOINT=
SEARCH_INDEX_NAME=disruption-knowledge

# Storage
STORAGE_BLOB_ENDPOINT=
KNOWLEDGE_CONTAINER=disruption-wiki

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Feature flags
ENABLE_DELIBERATION=true
ENABLE_FOUNDRY_HOSTED_AGENTS=true
